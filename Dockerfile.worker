# syntax=docker/dockerfile:1
#
# Sift distributed worker. Distroless static + nonroot.
#
# Build:
#   docker build -f Dockerfile.worker -t ghcr.io/asadbekabdulboqiyev/sift-worker:0.18.1 .
#
# Run (static fleet):
#   docker run --rm -p 50061:50061 \
#     --ulimit nofile=1048576:1048576 \
#     ghcr.io/asadbekabdulboqiyev/sift-worker:0.18.1 \
#     -listen 0.0.0.0:50061 -id docker-1 -max-users 200000
#
# Run (auto-discovery, reachable as docker-1:50061 on a shared network):
#   docker run --rm --network sift-net -p 50061:50061 \
#     --ulimit nofile=1048576:1048576 \
#     ghcr.io/asadbekabdulboqiyev/sift-worker:0.18.1 \
#     -listen 0.0.0.0:50061 -advertise docker-1:50061 \
#     -master master:50051 -id docker-1 -token "$TOKEN"
#
# NOTE: reaching very high connection counts needs --ulimit nofile and,
# preferably, --network host. This image cannot raise its own limits.

# Exact Go patch + digest, matching the `go 1.26.11` directive in go.mod.
# GOTOOLCHAIN=local makes a mismatch a hard build error instead of a silent
# toolchain download from the network during `go mod download`.
FROM golang:1.27.4@sha256:5f1b98fa02fe396ebce2a0227a0e08309e11792915b9dd2e1f71053d7e7e6666 AS builder

ENV GOTOOLCHAIN=local

ARG VERSION=dev
ARG REVISION=""
ARG TARGETOS
ARG TARGETARCH

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download && go mod verify

COPY . .

RUN CGO_ENABLED=0 GOOS="${TARGETOS:-linux}" GOARCH="${TARGETARCH:-amd64}" \
    go build -trimpath \
      -ldflags="-s -w \
        -X github.com/asadbekabdulboqiyev/sift/internal/version.Version=${VERSION} \
        -X github.com/asadbekabdulboqiyev/sift/internal/version.Commit=${REVISION}" \
      -o /out/Sift-worker ./cmd/sift-worker

RUN /out/Sift-worker --version

# Manifest-list digest for the multi-arch :nonroot index (amd64 + arm64).
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

ARG VERSION=dev
ARG REVISION=""

# CA bundle is required: the worker generates HTTPS load.
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

COPY --from=builder /out/Sift-worker /usr/local/bin/Sift-worker
# Lowercase alias for consistent CLI usage inside the container. distroless
# ships no shell and no `ln`, so `RUN ["ln", ...]` failed the build with
# `exec: "ln": executable file not found in $PATH` — a second COPY of the same
# file costs nothing and needs no tooling in the runtime layer.
COPY --from=builder /out/Sift-worker /usr/local/bin/sift-worker

# Apache-2.0 §4.
COPY LICENSE NOTICE /usr/share/doc/Sift/

USER 65532:65532

EXPOSE 50061 9091

STOPSIGNAL SIGTERM

# ── liveness probe ──────────────────────────────────────────────────────────
# distroless: no shell, no curl/wget. The probe invokes the worker binary's
# `healthcheck` subcommand directly (exec form, no shell).
#
# The `healthcheck` subcommand GETs --addr and exits 0 on 2xx, 1 on a failed
# request, 2 on bad usage:
#   Sift-worker healthcheck --addr http://127.0.0.1:9091/healthz
#
# The HTTP health/metrics server binds `-http-addr` (default 0.0.0.0:9091) and
# serves /healthz, /readyz (200 only once registered/ready) and /metrics.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD ["/usr/local/bin/Sift-worker", "healthcheck", "--addr", "http://127.0.0.1:9091/healthz"]

ENTRYPOINT ["/usr/local/bin/Sift-worker"]
# HTTP health/metrics default to 0.0.0.0:9091 (the healthcheck above assumes it).
# Pass `-http-addr 0.0.0.0:<port>` at run time to move it.
CMD ["-listen", "0.0.0.0:50061"]
