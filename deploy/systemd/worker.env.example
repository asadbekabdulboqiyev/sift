# Environment for the Sift-worker systemd unit.
#
# Install:
#   sudo mkdir -p /etc/Sift
#   sudo cp worker.env.example /etc/Sift/worker.env
#   sudo chmod 600 /etc/Sift/worker.env
#   sudo editor /etc/Sift/worker.env
#
# WORKER_ARGS is expanded by systemd as the worker command line. Set exactly the
# flags you need. Keep the value on ONE line.

# Static fleet: master connects to this worker directly.
WORKER_ARGS=-listen 0.0.0.0:50061 -id worker-1 -max-users 200000 -max-runs 4

# Auto-discovery: uncomment -master so this worker self-registers with the
# master; the master is then started with `-wait-workers N`.
# WORKER_ARGS=-listen 0.0.0.0:50061 -id worker-1 -max-users 200000 -max-runs 4 -master master.internal:50051 -advertise 10.0.0.11:50061

# Shared control-plane token. When the master is started with -token, every
# worker MUST use the SAME value or registration/command traffic is rejected.
# Set it on its own SIFT_WORKER_TOKEN line below. Do NOT put `-token <value>`
# inside WORKER_ARGS: systemd expands that variable into ExecStart, so the
# token would show up in the worker's argv (`ps`). An explicit -token flag
# still overrides this env value when you need to debug one worker.
# Keep this file root-owned, mode 600 (systemd reads it before dropping privs).
# Uncomment and replace with the SAME token the master was started with.
# SIFT_WORKER_TOKEN=change-me

# WORKER_ARGS=-listen 0.0.0.0:50061 -id worker-1 -max-users 200000 -max-runs 4 -master master.internal:50051

# Optional: raise socket limits via systemd is preferred; these are for shells.
# GOMAXPROCS=0
